{
  "name": "lookout",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "bin": {
    "lookout": "bin/lookout"
  },
  "scripts": {
    "check": "bun run typecheck && bun test && bun run fixtures:check",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "fixtures": "bun scripts/refresh-fixtures.ts",
    "fixtures:check": "bun scripts/refresh-fixtures.ts > /dev/null && git diff --quiet -- fixtures/reviews || (echo 'fixtures/reviews drifted from the pipeline; run bun run fixtures and commit' && git --no-pager diff --stat -- fixtures/reviews && exit 1)",
    "story": "bun stories/run.ts",
    "bench": "scripts/grouping-bench.sh",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.89",
    "@ai-sdk/google": "4.0.106",
    "@ai-sdk/openai": "4.0.103",
    "@ai-sdk/perplexity": "5.0.21",
    "@ai-sdk/typesafe-ai": "3.0.28",
    "ai": "7.0.154",
    "ink": "6.8.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "^7.0.2"
  }
}

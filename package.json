{
  "name": "lookout",
  "version": "0.1.0",
  "description": "Review agent-written code as a stack of colour-coded cards, one per logical change, instead of a diff",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicksenap/lookout.git"
  },
  "homepage": "https://github.com/nicksenap/lookout",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "bin": {
    "lookout": "bin/lookout"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run knip && bun test && bun run fixtures:check",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "knip": "knip --include files,dependencies,unlisted,unresolved",
    "knip:exports": "knip --include exports,types",
    "test": "bun test",
    "fixtures": "bun scripts/refresh-fixtures.ts",
    "fixtures:check": "bun scripts/refresh-fixtures.ts > /dev/null && git diff --quiet -- fixtures/reviews || (echo 'fixtures/reviews drifted from the pipeline; run bun run fixtures and commit' && git --no-pager diff --stat -- fixtures/reviews && exit 1)",
    "story": "bun stories/run.ts",
    "bench": "scripts/grouping-bench.sh",
    "hooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.89",
    "@ai-sdk/google": "4.0.106",
    "@ai-sdk/openai": "4.0.103",
    "@ai-sdk/perplexity": "5.0.21",
    "@ai-sdk/typesafe-ai": "3.0.28",
    "ai": "7.0.154",
    "ink": "6.8.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "knip": "^6.43.0",
    "typescript": "^7.0.2"
  }
}

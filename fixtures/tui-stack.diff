diff --git a/src/tui/App.tsx b/src/tui/App.tsx
new file mode 100644
index 0000000..b8abf10
--- /dev/null
+++ b/src/tui/App.tsx
@@ -0,0 +1,229 @@
+import { Box, render, Text, useApp, useInput, useStdout } from "ink";
+import { useEffect, useMemo, useRef, useState } from "react";
+import { cardDispatches, cardFindings, type ReviewSession } from "../core/session.ts";
+import type { Card, Dispatch, Review } from "../core/types.ts";
+import { type CardContext, cardLines, expandedLines, fit, type Line, plural, Row, sides } from "./Card.tsx";
+import { HELP_LINES, keyAction, keyHelp, type Mode } from "./keys.ts";
+import { theme } from "./theme.ts";
+
+export interface Size {
+  columns: number;
+  rows: number;
+}
+
+export interface AppProps {
+  session: ReviewSession;
+  dispatchable: boolean;
+  /** Fixed size for tests; otherwise follows the terminal. */
+  size?: Size;
+  /** Fixed spinner frame for tests. */
+  frame?: number;
+  /** Render throttle while events stream; 0 in tests so a frame follows each event. */
+  throttleMs?: number;
+}
+
+/** Re-render at most ~10/s while events stream; immediately when idle. */
+function useReview(session: ReviewSession, throttleMs: number): { review: Review; pending: boolean } {
+  const [state, setState] = useState(() => ({ review: session.snapshot(), pending: true }));
+  const pending = useRef(true);
+  useEffect(() => {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const flush = () => {
+      timer = undefined;
+      setState({ review: session.snapshot(), pending: pending.current });
+    };
+    const off = session.subscribe((e) => {
+      if (e.type === "done") pending.current = false;
+      if (!timer) timer = setTimeout(flush, throttleMs);
+    });
+    return () => {
+      off();
+      if (timer) clearTimeout(timer);
+    };
+  }, [session, throttleMs]);
+  return state;
+}
+
+function useSize(override?: Size): Size {
+  const { stdout } = useStdout();
+  const read = () => override ?? { columns: stdout.columns || 80, rows: stdout.rows || 24 };
+  const [size, setSize] = useState(read);
+  useEffect(() => {
+    if (override) return;
+    const onResize = () => setSize(read());
+    stdout.on("resize", onResize);
+    return () => void stdout.off("resize", onResize);
+  }, [stdout, override]);
+  return size;
+}
+
+function useFrame(active: boolean, override?: number): number {
+  const [frame, setFrame] = useState(0);
+  useEffect(() => {
+    if (!active || override !== undefined) return;
+    const t = setInterval(() => setFrame((f) => f + 1), 100);
+    return () => clearInterval(t);
+  }, [active, override]);
+  return override ?? frame;
+}
+
+/** The visible slice of `lines` keeping the selected card fully visible when it fits, else its top. */
+export function windowLines(lines: Line[], selected: number, height: number, prevTop: number): number {
+  const first = lines.findIndex((l) => l.card === selected);
+  if (first < 0) return Math.max(0, Math.min(prevTop, lines.length - height));
+  let last = first;
+  while (last + 1 < lines.length && lines[last + 1]!.card === selected) last++;
+  let top = prevTop;
+  if (first < top) top = first;
+  if (last >= top + height) top = Math.min(first, last - height + 1);
+  return Math.max(0, Math.min(top, Math.max(0, lines.length - height)));
+}
+
+export function App({ session, dispatchable, size: sizeOverride, frame: frameOverride, throttleMs = 100 }: AppProps) {
+  const { exit } = useApp();
+  const { review, pending } = useReview(session, throttleMs);
+  const size = useSize(sizeOverride);
+  const running = review.dispatches.find((d) => d.status === "running");
+  const frame = useFrame(pending || running !== undefined, frameOverride);
+  const [selected, setSelected] = useState(0);
+  const [mode, setMode] = useState<Mode>("stack");
+  const [help, setHelp] = useState(false);
+  const [scroll, setScroll] = useState(0);
+  const [top, setTop] = useState(0);
+  const [notice, setNotice] = useState<string>();
+  const startedAt = useRef(new Map<string, number>());
+  for (const d of review.dispatches) if (!startedAt.current.has(d.id)) startedAt.current.set(d.id, Date.now());
+  const elapsed = (d: Dispatch) => Date.now() - (startedAt.current.get(d.id) ?? Date.now());
+
+  const cards = review.cards;
+  const sel = Math.max(0, Math.min(selected, cards.length - 1));
+  const card: Card | undefined = cards[sel];
+  const w = size.columns;
+  const bodyH = Math.max(3, size.rows - 1 - 2); // header, footer; one row spare for Ink
+
+  const ctxFor = (c: Card): CardContext => ({ review, findings: cardFindings(review, c), dispatches: cardDispatches(review, c), pending, frame, elapsed });
+
+  const stackLines = useMemo(() => {
+    const out: Line[] = [];
+    cards.forEach((c, k) => {
+      out.push(...cardLines(c, k, k === sel, w, ctxFor(c)));
+      out.push({ segments: [{ text: "" }], card: k });
+    });
+    if (review.untouched.length > 0) out.push({ segments: [{ text: "┃ ", color: theme.faint }, { text: "UNTOUCHED", color: theme.faint, bold: true }, { text: `  ${fit(review.untouched.join(" · "), w - 13)}`, dim: true }] });
+    if (cards.length === 0) out.push({ segments: [{ text: "No edits in this change.", dim: true }] });
+    return out;
+  }, [review, sel, w, frame, pending]);
+
+  const bodyLines = useMemo(() => (mode === "expanded" && card ? [...cardLines(card, sel, true, w, ctxFor(card)), { segments: [{ text: "" }] }, ...expandedLines(card, w, ctxFor(card))] : stackLines), [mode, card, stackLines, w, frame]);
+  const windowTop = mode === "stack" ? windowLines(bodyLines, sel, bodyH, top) : Math.max(0, Math.min(scroll, bodyLines.length - bodyH));
+  useEffect(() => {
+    if (mode === "stack" && windowTop !== top) setTop(windowTop);
+  }, [windowTop, mode, top]);
+  const visible = bodyLines.slice(windowTop, windowTop + bodyH);
+
+  const review1 = async (c: Card) => {
+    setNotice(undefined);
+    const r = await session.command({ type: "dispatchCard", cardId: c.id });
+    if (!r.ok) setNotice(r.error);
+  };
+
+  useInput((input, key) => {
+    if (help) {
+      if (key.escape || input === "?" || input === "q" || key.return) setHelp(false);
+      return;
+    }
+    const action = keyAction(input, key);
+    if (!action) return;
+    setNotice(undefined);
+    switch (action.type) {
+      case "quit":
+        return exit();
+      case "help":
+        return setHelp(true);
+      case "expand":
+        if (card && card.fixed !== "clean") {
+          setScroll(0);
+          setMode("expanded");
+        }
+        return;
+      case "back":
+        return setMode("stack");
+      case "move":
+      case "page":
+      case "edge": {
+        if (mode === "expanded") {
+          const step = action.type === "move" ? action.delta : action.type === "page" ? action.delta * (bodyH - 1) : 0;
+          const to = action.type === "edge" ? (action.to === "top" ? 0 : bodyLines.length) : scroll + step;
+          return setScroll(Math.max(0, Math.min(to, Math.max(0, bodyLines.length - bodyH))));
+        }
+        const step = action.type === "move" ? action.delta : action.type === "page" ? action.delta * 3 : 0;
+        const to = action.type === "edge" ? (action.to === "top" ? 0 : cards.length - 1) : sel + step;
+        return setSelected(Math.max(0, Math.min(to, cards.length - 1)));
+      }
+      case "review":
+        if (!dispatchable) return setNotice("no dispatchers configured");
+        if (!card || card.fixed === "clean") return setNotice("nothing to review on this card");
+        return void review1(card);
+      case "reviewAll":
+        if (!dispatchable) return setNotice("no dispatchers configured");
+        return void session.command({ type: "dispatchAll" }).then((r) => !r.ok && setNotice(r.error));
+      case "cancel":
+        return void session.command({ type: "cancel" }).then((r) => setNotice(r.ok ? "cancelling…" : r.error));
+    }
+  });
+
+  const v = review.verdict;
+  const title = review.changeSet.intent?.title ? `${review.changeSet.target} · ${review.changeSet.intent.title}` : review.changeSet.target;
+  const headerRight = `${v.tier.toUpperCase()} · ${plural(v.requiredHumans, "human")} · ${plural(cards.length, "card")}${pending ? ` · ${theme.spinner[frame % theme.spinner.length]} ranking` : ""}`;
+  const header: Line = { segments: sides([{ text: " " }, { text: fit(title, Math.max(10, w - headerRight.length - 4)), bold: true }], headerRight, w, theme.tier[v.tier]) };
+  const footerText = notice ?? review.warning ?? keyHelp(mode, running !== undefined, dispatchable).map((h) => `${h.keys} ${h.label}`).join("  ·  ");
+  const footer: Line = { segments: [{ text: " " }, { text: fit(footerText, w - 1), color: notice ? theme.card.amber : undefined, dim: !notice }] };
+
+  return (
+    <Box flexDirection="column" width={w} height={size.rows - 1}>
+      <Row line={header} w={w} />
+      <Box flexDirection="column" height={bodyH}>
+        {help
+          ? HELP_LINES.slice(0, bodyH).map((l, k) => <Row key={k} line={{ segments: [{ text: ` ${fit(l, w - 1)}` }] }} w={w} />)
+          : visible.map((l, k) => <Row key={k} line={l} w={w} selected={mode === "stack" && l.card === sel && l.segments.length > 1} />)}
+        {!help && visible.length < bodyH ? Array.from({ length: bodyH - visible.length }, (_, k) => <Text key={`pad${k}`}> </Text>) : null}
+      </Box>
+      <Row line={footer} w={w} />
+    </Box>
+  );
+}
+
+const ENTER_ALT = "\x1b[?1049h\x1b[2J\x1b[H\x1b[?25l";
+const LEAVE_ALT = "\x1b[?25h\x1b[?1049l";
+
+/** Run the stack in the alternate screen; the terminal is restored on quit, signals and crashes. */
+export async function runTui(session: ReviewSession, dispatchable: boolean, onExit: () => Promise<void>): Promise<void> {
+  if (!process.stdin.isTTY || !process.stdout.isTTY) throw new Error("the TUI needs a terminal; use --json for non-interactive output");
+  process.stdout.write(ENTER_ALT);
+  let restored = false;
+  const restore = () => {
+    if (restored) return;
+    restored = true;
+    process.stdout.write(LEAVE_ALT);
+  };
+  process.once("exit", restore);
+  const onSignal = () => {
+    instance.unmount();
+    restore();
+    process.exit(130);
+  };
+  process.once("SIGTERM", onSignal);
+  process.once("SIGHUP", onSignal);
+  // No incrementalRendering: with a frame shorter than the terminal Ink 6.8's incremental
+  // writer drifts one row per frame. Full redraws are wrapped in synchronized output on TTYs.
+  const instance = render(<App session={session} dispatchable={dispatchable} />, { exitOnCtrlC: true, patchConsole: true });
+  try {
+    await instance.waitUntilExit();
+  } finally {
+    instance.cleanup();
+    restore();
+    await onExit();
+    process.off("SIGTERM", onSignal);
+    process.off("SIGHUP", onSignal);
+  }
+}
diff --git a/src/tui/Card.tsx b/src/tui/Card.tsx
new file mode 100644
index 0000000..3e5f5bc
--- /dev/null
+++ b/src/tui/Card.tsx
@@ -0,0 +1,204 @@
+import { Text } from "ink";
+import type { Card, Dispatch, Finding, Hunk, Review } from "../core/types.ts";
+import { COLOR_LABEL, theme } from "./theme.ts";
+
+export interface Segment {
+  text: string;
+  color?: string;
+  dim?: boolean;
+  bold?: boolean;
+  inverse?: boolean;
+}
+/** One terminal row. `card` is the stack index it belongs to (undefined for chrome). */
+export interface Line {
+  segments: Segment[];
+  card?: number;
+}
+
+export const width = (s: string): number => Bun.stringWidth(s);
+
+/** Cut `s` to at most `w` columns, with an ellipsis when cut. */
+export function fit(s: string, w: number): string {
+  if (w <= 0) return "";
+  if (width(s) <= w) return s;
+  let out = "";
+  for (const ch of s) {
+    if (width(out + ch) > w - 1) break;
+    out += ch;
+  }
+  return out + "…";
+}
+
+export function wrap(text: string, w: number): string[] {
+  if (w <= 0) return [];
+  const out: string[] = [];
+  for (const para of text.split("\n")) {
+    let line = "";
+    for (const word of para.split(/\s+/).filter(Boolean)) {
+      if (line === "") line = fit(word, w);
+      else if (width(`${line} ${word}`) <= w) line += ` ${word}`;
+      else {
+        out.push(line);
+        line = fit(word, w);
+      }
+    }
+    out.push(line);
+  }
+  return out;
+}
+
+export const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
+
+/** Fit a left and right part into `w` columns; the left part yields. */
+export function sides(left: Segment[], right: string, w: number, color?: string): Segment[] {
+  const leftText = left.map((s) => s.text).join("");
+  const rightW = width(right);
+  const gap = Math.max(1, w - width(leftText) - rightW);
+  if (width(leftText) + 1 + rightW > w) {
+    const cut = fit(leftText, Math.max(0, w - rightW - 1));
+    return [{ text: cut, color }, { text: " ".repeat(Math.max(1, w - width(cut) - rightW)) }, { text: right, dim: true }];
+  }
+  return [...left, { text: " ".repeat(gap) }, { text: right, dim: true }];
+}
+
+const BAR = "┃";
+
+export interface CardContext {
+  review: Review;
+  findings: Finding[];
+  dispatches: Dispatch[];
+  pending: boolean;
+  frame: number;
+  /** Elapsed ms for a running dispatch, by id. */
+  elapsed: (d: Dispatch) => number;
+}
+
+export function filesOf(review: Review, card: Card): string[] {
+  const ids = new Set(card.blockIds);
+  return review.changeSet.files.filter((f) => f.hunks.some((h) => h.blocks.some((b) => ids.has(b.id)))).map((f) => f.path);
+}
+
+/** A card as it appears in the stack: badge line, title, paragraph or summary, findings, running review. */
+export function cardLines(card: Card, index: number, selected: boolean, w: number, ctx: CardContext): Line[] {
+  const color = theme.card[card.color];
+  // The selected card gets a solid bar; others a thin one. Visible without color.
+  const bar: Segment = { text: `${selected ? "█" : BAR} `, color, bold: selected };
+  const inner = w - 2;
+  const row = (segs: Segment[]): Line => ({ segments: [bar, ...segs], card: index });
+
+  const files = filesOf(ctx.review, card);
+  const badges = [COLOR_LABEL[card.color], card.kind, ...card.labels.filter((l) => l !== "test" || card.kind !== "test"), ...card.areas.map((a) => `${a}/*`)];
+  const right = `${plural(card.blockIds.length, "edit")} · ${plural(files.length, "file")}${ctx.findings.length ? ` · ${plural(ctx.findings.length, "finding")}` : ""}`;
+  const badgeSegs: Segment[] = [{ text: badges[0]!, color, bold: true }, { text: badges.length > 1 ? `  ${badges.slice(1).join(" · ")}` : "", dim: true }];
+  const lines: Line[] = [row(sides(badgeSegs, right, inner, color))];
+
+  if (card.fixed === "clean") {
+    lines.push(row([{ text: fit(files.join(", "), inner), dim: true }]));
+    return lines;
+  }
+
+  lines.push(row([{ text: fit(card.title, inner), bold: true }]));
+  if (card.paragraph) for (const l of wrap(card.paragraph, inner)) lines.push(row([{ text: l }]));
+  else {
+    const spin = ctx.pending ? `${theme.spinner[ctx.frame % theme.spinner.length]} ` : "";
+    const summary = files.length === 1 ? `${card.attention}, score ${card.score.toFixed(2)}` : `${card.attention} · ${files.join(", ")}`;
+    lines.push(row([{ text: fit(`${spin}${summary}`, inner), dim: true }]));
+  }
+  for (const f of ctx.findings.slice(0, 4)) lines.push(row(findingLine(f, inner)));
+  if (ctx.findings.length > 4) lines.push(row([{ text: `  +${ctx.findings.length - 4} more`, dim: true }]));
+  const running = ctx.dispatches.find((d) => d.status === "running");
+  if (running) lines.push(row([{ text: `  ${theme.spinner[ctx.frame % theme.spinner.length]} ${running.dispatcher} reviewing… ${clock(ctx.elapsed(running))}`, color: theme.accent }]));
+  else {
+    const last = ctx.dispatches[0];
+    if (last && last.status !== "done") lines.push(row([{ text: `  ${last.dispatcher} ${last.status}${last.error ? `: ${fit(last.error, inner - 20)}` : ""}`, dim: true }]));
+    else if (last && ctx.findings.length === 0) lines.push(row([{ text: `  ✓ ${last.dispatcher} found nothing to report`, color: theme.card.green }]));
+  }
+  return lines;
+}
+
+export function findingLine(f: Finding, w: number): Segment[] {
+  const where = f.anchor ? `${f.anchor.path.split("/").pop()}:${f.anchor.line}` : "";
+  return sides([{ text: "  " }, { text: f.severity.toUpperCase(), color: theme.severity[f.severity], bold: true }, { text: ` ${f.title}` }], where, w);
+}
+
+export const clock = (ms: number) => {
+  const s = Math.floor(ms / 1000);
+  return `${String(Math.floor(s / 60)).padStart(2, "0")}:${String(s % 60).padStart(2, "0")}`;
+};
+
+/**
+ * Expanded card: findings in full, then the agent's status (its log while running or when it
+ * produced no findings), then the diff of its hunks with other cards' edits faded. Review first,
+ * diff as the appendix.
+ */
+export function expandedLines(card: Card, w: number, ctx: CardContext): Line[] {
+  const color = theme.card[card.color];
+  const ids = new Set(card.blockIds);
+  const lines: Line[] = [];
+  const push = (segs: Segment[]) => lines.push({ segments: segs });
+
+  if (ctx.findings.length > 0) {
+    push([{ text: `findings (${ctx.findings.length})`, color, bold: true }]);
+    for (const f of ctx.findings) {
+      push(findingLine(f, w));
+      for (const l of wrap(f.body, w - 5)) push([{ text: `     ${l}`, dim: true }]);
+      push([{ text: `     by ${f.dispatcher}`, dim: true }]);
+    }
+    push([{ text: "" }]);
+  }
+
+  const d = ctx.dispatches[0];
+  if (d) {
+    const status = d.status === "running" ? `${theme.spinner[ctx.frame % theme.spinner.length]} running ${clock(ctx.elapsed(d))}` : d.status;
+    push([{ text: `${d.dispatcher} · ${status}`, color: theme.accent, bold: true }, { text: `  ${fit(d.cmd, Math.max(0, w - 30))}`, dim: true }]);
+    const showLog = d.status === "running" || (d.status === "done" && d.findings.length === 0) || d.status === "failed";
+    if (showLog) {
+      const text = (d.status === "running" ? d.output : d.freeform || d.output || d.error || "").replace(/\x1b\[[0-9;]*[A-Za-z]/g, "");
+      const rows = text.split("\n").filter((l) => l.trim() !== "");
+      for (const raw of rows.slice(d.status === "running" ? -12 : -60)) push([{ text: fit(raw.replace(/\r.*$/, ""), w), dim: true }]);
+    }
+    push([{ text: "" }]);
+  }
+
+  push([{ text: `diff · ${plural(card.blockIds.length, "edit")}`, color, bold: true }, { text: "   other cards' edits in these hunks are faded", dim: true }]);
+  for (const file of ctx.review.changeSet.files) {
+    const hunks = file.hunks.filter((h) => h.blocks.some((b) => ids.has(b.id)));
+    if (hunks.length === 0) continue;
+    push([{ text: fit(file.path, w), color: theme.accent, bold: true }]);
+    for (const h of hunks) {
+      push([{ text: fit(h.header, w), dim: true }]);
+      for (const l of hunkRows(h, ids, w)) push(l);
+    }
+    push([{ text: "" }]);
+  }
+  return lines;
+}
+
+function hunkRows(h: Hunk, ids: Set<string>, w: number): Segment[][] {
+  const owned = new Set<number>();
+  for (const b of h.blocks) if (ids.has(b.id)) for (let k = b.from; k < b.to; k++) owned.add(k);
+  return h.lines.map((l, k) => {
+    const sign = l.kind === "add" ? "+" : l.kind === "del" ? "-" : " ";
+    const no = String(l.newLine ?? l.oldLine ?? "").padStart(4);
+    const text = fit(`${no} ${sign} ${l.text}`, w);
+    if (l.kind === "context") return [{ text, color: theme.context }];
+    if (!owned.has(k)) return [{ text, dim: true }];
+    return [{ text, color: l.kind === "add" ? theme.add : theme.del }];
+  });
+}
+
+/** Render one Line as Ink, truncated to `w` columns. */
+export function Row({ line, w, selected }: { line: Line; w: number; selected?: boolean }) {
+  const total = line.segments.map((s) => s.text).join("");
+  const pad = Math.max(0, w - width(total));
+  return (
+    <Text wrap="truncate-end" backgroundColor={selected ? theme.selectedBg : undefined}>
+      {line.segments.map((s, k) => (
+        <Text key={k} color={s.color} dimColor={s.dim} bold={s.bold} inverse={s.inverse}>
+          {s.text}
+        </Text>
+      ))}
+      {pad > 0 ? <Text>{" ".repeat(pad)}</Text> : null}
+    </Text>
+  );
+}

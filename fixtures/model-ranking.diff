index 0000000..38fd6d8
--- /dev/null
+++ b/src/rank/model.ts
@@ -0,0 +1,104 @@
+// All experimental AI SDK usage lives in this file.
+import { createAnthropic } from "@ai-sdk/anthropic";
+import { createGoogleGenerativeAI } from "@ai-sdk/google";
+import { createOpenAI } from "@ai-sdk/openai";
+import { createPerplexity } from "@ai-sdk/perplexity";
+import { createTypeSafeAi } from "@ai-sdk/typesafe-ai";
+import { createProviderRegistry, experimental_decide, type Experimental_DecisionModel, type Experimental_DecisionQuestion } from "ai";
+import type { Hunk, Intent } from "../core/types.ts";
+
+export type AttentionModel = Experimental_DecisionModel;
+export type Env = Record<string, string | undefined>;
+
+/** Registry provider id → env var holding its key. BYOK only; no gateway. */
+export const PROVIDER_KEYS = {
+  openai: "OPENAI_API_KEY",
+  anthropic: "ANTHROPIC_API_KEY",
+  google: "GOOGLE_GENERATIVE_AI_API_KEY",
+  perplexity: "PERPLEXITY_API_KEY",
+  "typesafe-ai": "TYPESAFE_AI_API_KEY",
+} as const;
+type ProviderId = keyof typeof PROVIDER_KEYS;
+
+const FACTORIES: Record<ProviderId, (apiKey: string) => Parameters<typeof createProviderRegistry>[0][string]> = {
+  openai: (apiKey) => createOpenAI({ apiKey }),
+  anthropic: (apiKey) => createAnthropic({ apiKey }),
+  google: (apiKey) => createGoogleGenerativeAI({ apiKey }),
+  perplexity: (apiKey) => createPerplexity({ apiKey }),
+  "typesafe-ai": (apiKey) => createTypeSafeAi({ apiKey }),
+};
+
+export type ResolvedModel = { ok: true; model: AttentionModel } | { ok: false; reason: string };
+
+/** Build the registry from whichever keys are present and resolve `provider:model`. */
+export function resolveAttentionModel(spec: string, env: Env): ResolvedModel {
+  const sep = spec.indexOf(":");
+  const providerId = sep > 0 ? spec.slice(0, sep) : "";
+  if (!(providerId in PROVIDER_KEYS)) {
+    return { ok: false, reason: `unknown provider in rank.model "${spec}" (known: ${Object.keys(PROVIDER_KEYS).join(", ")})` };
+  }
+  const providers: Parameters<typeof createProviderRegistry>[0] = {};
+  for (const [id, keyVar] of Object.entries(PROVIDER_KEYS) as [ProviderId, string][]) {
+    const key = env[keyVar];
+    if (key) providers[id] = FACTORIES[id](key);
+  }
+  if (!providers[providerId]) return { ok: false, reason: `no ${PROVIDER_KEYS[providerId as ProviderId]} set` };
+  const registry = createProviderRegistry(providers);
+  try {
+    return { ok: true, model: registry.decisionModel(spec as `${string}:${string}`) };
+  } catch (err) {
+    return { ok: false, reason: err instanceof Error ? err.message : String(err) };
+  }
+}
+
+/** Levels of the `review_attention` score question; index = score. */
+export const ATTENTION_LEVELS = [
+  "trivial: mechanical, cosmetic, or obviously safe; a glance is enough",
+  "routine: ordinary change that matches its context; skim it",
+  "needs-eyes: non-trivial logic, behaviour change, data/security/concurrency/error-handling impact; review carefully",
+  "suspicious: likely bug, security risk, contradicts the stated intent, weakens or deletes checks/tests, or does something unexplained",
+] as const;
+
+const MAX_LINES_PER_HUNK = 200;
+
+export const questionId = (hunkId: string) => `review_attention_${hunkId}`;
+
+function hunkText(h: Hunk): string {
+  const body = h.lines.slice(0, MAX_LINES_PER_HUNK).map((l) => (l.kind === "add" ? "+" : l.kind === "del" ? "-" : " ") + l.text);
+  if (h.lines.length > MAX_LINES_PER_HUNK) body.push(`… ${h.lines.length - MAX_LINES_PER_HUNK} more lines`);
+  return `${h.header}\n${body.join("\n")}`;
+}
+
+/**
+ * One `decide` call for a batch of hunks of the same change. Shared state is the
+ * change intent plus the batch; each hunk gets one `review_attention` score question.
+ * Returns score per hunk id in [0, ATTENTION_LEVELS.length - 1].
+ */
+export async function scoreHunkBatch(model: AttentionModel, hunks: Hunk[], intent?: Intent): Promise<Map<string, number>> {
+  const questions: Record<string, Experimental_DecisionQuestion> = {};
+  for (const h of hunks) {
+    questions[questionId(h.id)] = {
+      type: "score",
+      instructions: `How much reviewer attention does hunk ${h.id} (${h.path}) need? Judge only that hunk, using the rest of the state as context.`,
+      criteria: [...ATTENTION_LEVELS],
+    };
+  }
+  const state = {
+    task: "Rank hunks of an agent-written code change by how much human review attention each deserves.",
+    intent: intent ? { title: intent.title, body: intent.body.slice(0, 4000) } : null,
+    hunks: hunks.map((h) => ({ id: h.id, path: h.path, labels: h.labels, diff: hunkText(h) })),
+  };
+  const result = await experimental_decide({
+    model,
+    state,
+    questions,
+    abortSignal: AbortSignal.timeout(90_000),
+  });
+  const scores = new Map<string, number>();
+  for (const h of hunks) {
+    const answer = (result.answers as Record<string, { type: string; score?: number }>)[questionId(h.id)];
+    if (answer?.type !== "score" || typeof answer.score !== "number") throw new Error(`no score for hunk ${h.id}`);
+    scores.set(h.id, answer.score);
+  }
+  return scores;
+}
diff --git a/src/rank/rank.ts b/src/rank/rank.ts
index 66ff3e3..0cf3570 100644
--- a/src/rank/rank.ts
+++ b/src/rank/rank.ts
@@ -1,4 +1,6 @@
-import { ATTENTION_ORDER, type ChangeSet, type Hunk } from "../core/types.ts";
+import { ATTENTION_ORDER, type Attention, type ChangeSet, type Hunk } from "../core/types.ts";
+import { RankCache } from "./cache.ts";
+import { type AttentionModel, type Env, resolveAttentionModel, type ResolvedModel, scoreHunkBatch, ATTENTION_LEVELS } from "./model.ts";
 import { applyRules } from "./rules.ts";
 
 export interface RankResult {
@@ -7,11 +9,93 @@ export interface RankResult {
   warning?: string;
 }
 
-export async function rankChangeSet(changeSet: ChangeSet): Promise<RankResult> {
-  return { changeSet: applyRules(changeSet), rankedBy: "rules" };
+export interface ModelRankOptions {
+  /** "provider:model" from `[rank] model`. */
+  modelSpec: string;
+  env?: Env;
+  cache?: RankCache;
+  /** Injection point for tests (mock decision model). */
+  resolveModel?: (spec: string, env: Env) => ResolvedModel;
+  batchSize?: number;
+  concurrency?: number;
 }
 
 /** Highest attention first, then highest score; stable for equal keys. */
 export function compareHunks(a: Hunk, b: Hunk): number {
   return ATTENTION_ORDER.indexOf(b.attention) - ATTENTION_ORDER.indexOf(a.attention) || b.score - a.score;
 }
+
+const rank = (a: Attention) => ATTENTION_ORDER.indexOf(a);
+
+/**
+ * Merge a model score (0..levels-1) into a rules-ranked hunk. Rules bound the model:
+ * the model can only raise attention, and only rules can make a hunk inert.
+ */
+export function mergeModelScore(h: Hunk, modelScore: number): Hunk {
+  const top = ATTENTION_LEVELS.length - 1;
+  const level = Math.max(0, Math.min(top, Math.round(modelScore)));
+  // level 0 "trivial" / 1 "routine" never un-hide an inert hunk; 2+ raise anything.
+  // ATTENTION_LEVELS and ATTENTION_ORDER share indexes 2 (needs-eyes) and 3 (suspicious).
+  const fromModel: Attention = level >= 2 ? ATTENTION_ORDER[level]! : h.attention === "inert" ? "inert" : "routine";
+  const attention = rank(fromModel) > rank(h.attention) ? fromModel : h.attention;
+  const score = Math.round((0.3 * h.score + 0.7 * (modelScore / top)) * 1000) / 1000;
+  return { ...h, attention, score };
+}
+
+async function mapLimit<T, R>(items: T[], limit: number, fn: (item: T) => Promise<R>): Promise<R[]> {
+  const out: R[] = new Array(items.length);
+  let next = 0;
+  const workers = Array.from({ length: Math.min(limit, items.length) }, async () => {
+    while (next < items.length) {
+      const i = next++;
+      out[i] = await fn(items[i]!);
+    }
+  });
+  await Promise.all(workers);
+  return out;
+}
+
+/** Raise attention using the configured decision model; never fatal. */
+export async function rankWithModel(ruled: ChangeSet, opts: ModelRankOptions): Promise<RankResult> {
+  const env = opts.env ?? process.env;
+  const resolved = (opts.resolveModel ?? resolveAttentionModel)(opts.modelSpec, env);
+  if (!resolved.ok) return { changeSet: ruled, rankedBy: "rules", warning: `Rules-only ranking: ${resolved.reason}.` };
+
+  const cache = opts.cache ?? new RankCache();
+  const model: AttentionModel = resolved.model;
+  const hunks = ruled.files.flatMap((f) => f.hunks);
+  const missing = hunks.filter((h) => cache.get(opts.modelSpec, h.id) === undefined);
+  const size = opts.batchSize ?? 20;
+  const batches: Hunk[][] = [];
+  for (let i = 0; i < missing.length; i += size) batches.push(missing.slice(i, i + size));
+
+  let failure: string | undefined;
+  await mapLimit(batches, opts.concurrency ?? 4, async (batch) => {
+    try {
+      const scores = await scoreHunkBatch(model, batch, ruled.intent);
+      for (const [id, s] of scores) cache.set(opts.modelSpec, id, s);
+    } catch (err) {
+      failure ??= err instanceof Error ? err.message.split("\n")[0]! : String(err);
+    }
+  });
+  if (batches.length > 0) {
+    try {
+      cache.save();
+    } catch {
+      // A read-only cache dir only costs a re-rank next time.
+    }
+  }
+  if (failure) return { changeSet: ruled, rankedBy: "rules", warning: `Rules-only ranking: ${opts.modelSpec} failed (${failure}).` };
+
+  const changeSet: ChangeSet = {
+    ...ruled,
+    files: ruled.files.map((f) => ({ ...f, hunks: f.hunks.map((h) => mergeModelScore(h, cache.get(opts.modelSpec, h.id)!)) })),
+  };
+  return { changeSet, rankedBy: `rules+${opts.modelSpec}` };
+}
+
+export async function rankChangeSet(changeSet: ChangeSet, opts?: ModelRankOptions): Promise<RankResult> {
+  const ruled = applyRules(changeSet);
+  if (!opts) return { changeSet: ruled, rankedBy: "rules" };
+  return rankWithModel(ruled, opts);
+}

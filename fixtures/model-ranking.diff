index 0000000..f9b5b5f
--- /dev/null
+++ b/src/dispatch/config.ts
@@ -0,0 +1,93 @@
+import { existsSync, readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export const DEFAULT_CONFIG_PATH = join(homedir(), ".config", "lookout", "config.toml");
+export const DEFAULT_MODEL = "openai:gpt-6-luna";
+export const PLACEHOLDERS = ["prompt", "prompt_file", "repo", "diff_file"] as const;
+
+export interface DispatcherConfig {
+  name: string;
+  cmd: string;
+}
+
+export interface Config {
+  rank: { model: string };
+  /** Ordered as written in the file; the first is the default. */
+  dispatchers: DispatcherConfig[];
+  /** Optional override of the default prompt template. */
+  prompt?: string;
+  /** Where the config came from, for error messages. */
+  source: string;
+}
+
+export const BUILTIN_DISPATCHERS: DispatcherConfig[] = [{ name: "pi", cmd: "pi -p {prompt_file}" }];
+
+export class ConfigError extends Error {}
+
+const isTable = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+
+/** `{name}` tokens in a template; `{{`/`}}` are literal braces. */
+export function placeholdersIn(template: string): string[] {
+  const names: string[] = [];
+  for (const m of template.replace(/\{\{|\}\}/g, "").matchAll(/\{([^{}\s]*)\}/g)) names.push(m[1]!);
+  return names;
+}
+
+export function checkPlaceholders(template: string, where: string, allowed: readonly string[]): void {
+  for (const name of placeholdersIn(template)) {
+    if (!allowed.includes(name)) {
+      throw new ConfigError(`${where}: unknown placeholder {${name}}. Allowed: ${allowed.map((p) => `{${p}}`).join(" ")}`);
+    }
+  }
+}
+
+/** Validate a parsed TOML document. Hand-written checks so messages name the exact key. */
+export function validateConfig(raw: unknown, source: string): Config {
+  if (!isTable(raw)) throw new ConfigError(`${source}: expected a TOML table at top level`);
+  const known = new Set(["rank", "dispatch", "prompt"]);
+  for (const key of Object.keys(raw)) if (!known.has(key)) throw new ConfigError(`${source}: unknown key "${key}" (expected rank, dispatch, prompt)`);
+
+  let model = DEFAULT_MODEL;
+  if (raw.rank !== undefined) {
+    if (!isTable(raw.rank)) throw new ConfigError(`${source}: [rank] must be a table`);
+    for (const key of Object.keys(raw.rank)) if (key !== "model") throw new ConfigError(`${source}: unknown key "rank.${key}" (expected rank.model)`);
+    if (raw.rank.model !== undefined) {
+      if (typeof raw.rank.model !== "string" || !/^[\w.-]+:.+$/.test(raw.rank.model)) {
+        throw new ConfigError(`${source}: rank.model must be a "provider:model" string, e.g. "${DEFAULT_MODEL}"`);
+      }
+      model = raw.rank.model;
+    }
+  }
+
+  let dispatchers = BUILTIN_DISPATCHERS;
+  if (raw.dispatch !== undefined) {
+    if (!isTable(raw.dispatch)) throw new ConfigError(`${source}: [dispatch] must contain [dispatch.<name>] tables`);
+    dispatchers = Object.entries(raw.dispatch).map(([name, d]) => {
+      if (!isTable(d)) throw new ConfigError(`${source}: [dispatch.${name}] must be a table with a cmd`);
+      for (const key of Object.keys(d)) if (key !== "cmd") throw new ConfigError(`${source}: unknown key "dispatch.${name}.${key}" (expected cmd)`);
+      if (typeof d.cmd !== "string" || d.cmd.trim() === "") throw new ConfigError(`${source}: dispatch.${name}.cmd must be a non-empty string`);
+      checkPlaceholders(d.cmd, `${source}: dispatch.${name}.cmd`, PLACEHOLDERS);
+      return { name, cmd: d.cmd };
+    });
+    if (dispatchers.length === 0) throw new ConfigError(`${source}: [dispatch] has no dispatchers`);
+  }
+
+  const config: Config = { rank: { model }, dispatchers, source };
+  if (raw.prompt !== undefined) {
+    if (typeof raw.prompt !== "string" || raw.prompt.trim() === "") throw new ConfigError(`${source}: prompt must be a non-empty string`);
+    config.prompt = raw.prompt;
+  }
+  return config;
+}
+
+export function loadConfig(path: string = DEFAULT_CONFIG_PATH): Config {
+  if (!existsSync(path)) return { rank: { model: DEFAULT_MODEL }, dispatchers: BUILTIN_DISPATCHERS, source: "built-in defaults" };
+  let raw: unknown;
+  try {
+    raw = Bun.TOML.parse(readFileSync(path, "utf8"));
+  } catch (err) {
+    throw new ConfigError(`${path}: invalid TOML: ${err instanceof Error ? err.message : String(err)}`);
+  }
+  return validateConfig(raw, path);
+}

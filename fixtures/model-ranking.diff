@@ -0,0 +1,41 @@
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+export const DEFAULT_CACHE_DIR = join(homedir(), ".cache", "lookout");
+
+/** Model attention scores keyed by `${model}|${hunkId}`, persisted as one JSON file. */
+export class RankCache {
+  private readonly file: string;
+  private entries: Record<string, number>;
+
+  constructor(private readonly dir: string = DEFAULT_CACHE_DIR) {
+    this.file = join(dir, "rank-cache.json");
+    try {
+      const parsed: unknown = JSON.parse(readFileSync(this.file, "utf8"));
+      this.entries = parsed && typeof parsed === "object" ? (parsed as Record<string, number>) : {};
+    } catch {
+      this.entries = {};
+    }
+  }
+
+  private static key(model: string, hunkId: string): string {
+    return `${model}|${hunkId}`;
+  }
+
+  get(model: string, hunkId: string): number | undefined {
+    const v = this.entries[RankCache.key(model, hunkId)];
+    return typeof v === "number" ? v : undefined;
+  }
+
+  set(model: string, hunkId: string, score: number): void {
+    this.entries[RankCache.key(model, hunkId)] = score;
+  }
+
+  save(): void {
+    mkdirSync(this.dir, { recursive: true });
+    const tmp = `${this.file}.${process.pid}.tmp`;
+    writeFileSync(tmp, JSON.stringify(this.entries));
+    renameSync(tmp, this.file);
+  }
+}
diff --git a/src/rank/model.ts b/src/rank/model.ts

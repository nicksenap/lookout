+  /** Highest attention and score among the card's blocks. */
+  attention: Attention;
+  score: number;
+  /** Written by the LLM step from this card's blocks; absent until then. */
+  paragraph?: string;
+  /** The fixed card that collects every inert block. */
+  fixed?: "clean";
+}
+

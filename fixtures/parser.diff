@@ -0,0 +1,35 @@
+import { parseDiff } from "../core/diff.ts";
+import type { ChangeSet } from "../core/types.ts";
+import { run } from "./exec.ts";
+
+/** Flags that pin git's diff output to the format parseDiff expects regardless of user config. */
+export const DIFF_FLAGS = ["--no-color", "--no-ext-diff", "--no-textconv", "-M", "--src-prefix=a/", "--dst-prefix=b/"];
+
+export async function repoRoot(cwd: string = process.cwd()): Promise<string> {
+  return (await run(["git", "rev-parse", "--show-toplevel"], cwd)).trim();
+}
+
+async function revParse(rev: string, cwd: string): Promise<string> {
+  return (await run(["git", "rev-parse", "--verify", "--end-of-options", `${rev}^{commit}`], cwd)).trim();
+}
+
+/** Working tree (staged + unstaged) vs HEAD. */
+export async function loadWorktree(cwd: string = process.cwd()): Promise<ChangeSet> {
+  const head = await revParse("HEAD", cwd);
+  const text = await run(["git", "diff", ...DIFF_FLAGS, "HEAD", "--"], cwd);
+  return { target: "worktree", base: head, head: "worktree", files: parseDiff(text) };
+}
+
+/** `A..B` (B defaults to HEAD) or `A...B` (diff from merge-base). */
+export async function loadRange(range: string, cwd: string = process.cwd()): Promise<ChangeSet> {
+  const threeDot = range.includes("...");
+  const [left, right] = range.split(threeDot ? "..." : "..");
+  const a = left || "HEAD";
+  const b = right || "HEAD";
+  const headSha = await revParse(b, cwd);
+  const baseSha = threeDot
+    ? (await run(["git", "merge-base", a, b], cwd)).trim()
+    : await revParse(a, cwd);
+  const text = await run(["git", "diff", ...DIFF_FLAGS, baseSha, headSha, "--"], cwd);
+  return { target: range, base: baseSha, head: headSha, files: parseDiff(text) };
+}

+/** Run a command and return stdout; throw with stderr on non-zero exit. */
+export async function run(cmd: string[], cwd: string = process.cwd()): Promise<string> {
+  const proc = Bun.spawn(cmd, { cwd, stdout: "pipe", stderr: "pipe", stdin: "ignore" });
+  const [out, err, code] = await Promise.all([
+    new Response(proc.stdout).text(),
+    new Response(proc.stderr).text(),
+    proc.exited,
+  ]);
+  if (code !== 0) throw new Error(`${cmd.join(" ")} failed (exit ${code}): ${err.trim() || out.trim()}`);
+  return out;
+}

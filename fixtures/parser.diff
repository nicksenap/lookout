+export type Attention = "inert" | "routine" | "needs-eyes" | "suspicious";
+export const ATTENTION_ORDER: readonly Attention[] = ["inert", "routine", "needs-eyes", "suspicious"];
+
+export type FileStatus = "added" | "modified" | "deleted" | "renamed";
+
+export interface DiffLine {
+  kind: "context" | "add" | "del";
+  text: string;
+  oldLine?: number;
+  newLine?: number;
+  /** "\ No newline at end of file" followed this line. */
+  noNewlineAtEof?: boolean;
+}
+
+export interface Hunk {
+  id: string;
+  path: string;
+  header: string;
+  oldStart: number;
+  oldLines: number;
+  newStart: number;
+  newLines: number;
+  lines: DiffLine[];
+  labels: string[];
+  attention: Attention;
+  score: number;
+}
+
+export interface FileChange {
+  path: string;
+  oldPath?: string;
+  status: FileStatus;
+  binary: boolean;
+  hunks: Hunk[];
+}
+
+export interface Intent {
+  title: string;
+  body: string;
+}
+
+export interface ChangeSet {
+  target: string;
+  base: string;
+  head: string;
+  files: FileChange[];
+  intent?: Intent;
+}
+
+export type Severity = "p0" | "p1" | "p2";
+
+export interface Finding {
+  id: string;
+  severity: Severity;
+  title: string;
+  body: string;
+  anchor?: { path: string; line: number };
+  dispatcher: string;
+}
+
+export type DispatchStatus = "running" | "done" | "failed" | "cancelled";
+
+export interface Dispatch {
+  id: string;
+  dispatcher: string;
+  scope: "hunk" | "change";
+  /** Hunk id when scope is "hunk". */
+  hunkId?: string;
+  cmd: string;
+  status: DispatchStatus;
+  output: string;
+  findings: Finding[];
+  /** Output that is not a findings block (freeform text, parse errors). */
+  freeform?: string;
+  error?: string;
+}
+
+export interface Review {
+  changeSet: ChangeSet;
+  dispatches: Dispatch[];
+  rankedBy: string; // "rules" | `rules+${model}`
+  warning?: string;
+}

+  --version     print version
+  --help        this help`;
+
+interface CliArgs {
+  json: boolean;
+  target?: string;
+}
+
+function parseArgs(argv: string[]): CliArgs {
+  const args: CliArgs = { json: false };
+  for (const a of argv) {
+    if (a === "--json") args.json = true;
+    else if (a === "--version" || a === "-v") {

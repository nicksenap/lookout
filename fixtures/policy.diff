diff --git a/src/policy/evaluate.ts b/src/policy/evaluate.ts
new file mode 100644
index 0000000..1e0c5fc
--- /dev/null
+++ b/src/policy/evaluate.ts
@@ -0,0 +1,93 @@
+import { allBlocks } from "../core/blocks.ts";
+import { ATTENTION_ORDER, type Attention, type ChangeKind, type ChangeSet, type Classification, TIER_ORDER, type Tier, type Verdict } from "../core/types.ts";
+import { globToRegExp } from "../rank/rules.ts";
+import type { Policy } from "./schema.ts";
+
+const rank = (a: Attention) => ATTENTION_ORDER.indexOf(a);
+const tierRank = (t: Tier) => TIER_ORDER.indexOf(t);
+const maxTier = (a: Tier, b: Tier): Tier => (tierRank(a) >= tierRank(b) ? a : b);
+
+const CONFIG_RE = /(^|\/)(\.env[^/]*|[^/]+\.(toml|ya?ml|json|json5|ini|cfg|conf|properties|env))$/i;
+const DEPS_RE = /(^|\/)(package\.json|pyproject\.toml|requirements[^/]*\.txt|go\.mod|Cargo\.toml|build\.gradle(\.kts)?|pom\.xml|Gemfile|composer\.json)$/;
+
+export function areasOf(policy: Policy, path: string): string[] {
+  const out: string[] = [];
+  for (const [name, globs] of Object.entries(policy.areas)) if (globs.some((g) => globToRegExp(g).test(path))) out.push(name);
+  return out;
+}
+
+/** Change-level kind from the non-inert blocks. "logic" is the default; narrower kinds need every block to agree. */
+export function kindOf(blocks: { path: string; labels: string[]; hasDeletions: boolean }[]): ChangeKind {
+  if (blocks.length === 0) return "docs";
+  const every = (f: (b: (typeof blocks)[number]) => boolean) => blocks.every(f);
+  if (every((b) => b.labels.includes("docs"))) return "docs";
+  if (every((b) => b.labels.includes("test"))) return "test";
+  if (every((b) => b.labels.includes("lockfile") || DEPS_RE.test(b.path))) return "deps";
+  if (every((b) => b.labels.includes("ci"))) return "ci";
+  if (every((b) => CONFIG_RE.test(b.path) && !DEPS_RE.test(b.path))) return "config";
+  // Additive: nothing removed in non-test code (new files, new functions, new tests). Edits to existing lines are logic.
+  if (every((b) => b.labels.includes("test") || b.labels.includes("docs") || !b.hasDeletions)) return "additive";
+  return "logic";
+}
+
+export function classify(changeSet: ChangeSet, policy: Policy): Classification {
+  const refs = allBlocks(changeSet);
+  const live = refs.filter((r) => r.block.attention !== "inert");
+  const areas = new Set<string>();
+  const sensitivePaths = new Set<string>();
+  let maxAttention: Attention = "inert";
+  for (const r of live) {
+    for (const a of areasOf(policy, r.block.path)) areas.add(a);
+    if (r.block.labels.includes("sensitive")) sensitivePaths.add(r.block.path);
+    if (rank(r.block.attention) > rank(maxAttention)) maxAttention = r.block.attention;
+  }
+  const kind = kindOf(
+    live.map((r) => ({
+      path: r.block.path,
+      labels: r.block.labels,
+      hasDeletions: r.hunk.lines.slice(r.block.from, r.block.to).some((l) => l.kind === "del") && r.file.status !== "added",
+    })),
+  );
+  return {
+    kind,
+    areas: [...areas].sort(),
+    maxAttention,
+    sensitivePaths: [...sensitivePaths].sort(),
+    counts: { files: changeSet.files.length, blocks: refs.length, inert: refs.length - live.length },
+  };
+}
+
+/**
+ * Tier = max(kind default, every matching rule, floors). Floors are not configurable:
+ * a touched area is never low, and a suspicious block is at least medium.
+ */
+export function evaluate(c: Classification, policy: Policy): Verdict {
+  const reasons: { tier: Tier; text: string }[] = [];
+  let tier: Tier = policy.kinds[c.kind];
+  reasons.push({ tier, text: `${c.kind} change → ${tier}` });
+
+  for (const rule of policy.rules) {
+    if (rule.area && !c.areas.includes(rule.area)) continue;
+    if (rule.kind && c.kind !== rule.kind) continue;
+    if (rule.attention && rank(c.maxAttention) < rank(rule.attention)) continue;
+    const what = rule.reason ?? [rule.area && `touches ${rule.area}`, rule.kind && `${rule.kind} change`, rule.attention && `a block is ${rule.attention}`].filter(Boolean).join(", ");
+    reasons.push({ tier: rule.tier, text: `${what} → ${rule.tier}` });
+    tier = maxTier(tier, rule.tier);
+  }
+
+  if (c.areas.length > 0 && tier === "low") {
+    tier = "medium";
+    reasons.push({ tier, text: `touches ${c.areas.join(", ")}: never low` });
+  }
+  if (c.maxAttention === "suspicious" && tierRank(tier) < tierRank("medium")) {
+    tier = "medium";
+    reasons.push({ tier, text: "a suspicious block: at least medium" });
+  }
+  if (c.sensitivePaths.length > 0 && tier === "low") {
+    tier = "medium";
+    reasons.push({ tier, text: `sensitive path ${c.sensitivePaths[0]}${c.sensitivePaths.length > 1 ? ` (+${c.sensitivePaths.length - 1})` : ""}: never low` });
+  }
+
+  reasons.sort((a, b) => tierRank(b.tier) - tierRank(a.tier));
+  return { tier, requiredHumans: policy.humans[tier], reasons: reasons.map((r) => r.text) };
+}
diff --git a/src/policy/schema.ts b/src/policy/schema.ts
new file mode 100644
index 0000000..731e2ab
--- /dev/null
+++ b/src/policy/schema.ts
@@ -0,0 +1,129 @@
+import type { ChangeKind, Tier } from "../core/types.ts";
+import { ok, err, type Result } from "../core/result.ts";
+
+/** A rule raises the tier to at least `tier` when every stated condition holds. */
+export interface PolicyRule {
+  area?: string;
+  kind?: ChangeKind;
+  /** Any block at or above this attention. */
+  attention?: "needs-eyes" | "suspicious";
+  tier: Tier;
+  reason?: string;
+}
+
+export interface Policy {
+  /** Area name → path globs (same syntax as rank/rules globs). */
+  areas: Record<string, string[]>;
+  /** Minimum tier per change kind, before rules and floors. */
+  kinds: Record<ChangeKind, Tier>;
+  humans: Record<Tier, 0 | 1 | 2>;
+  rules: PolicyRule[];
+  source: string;
+}
+
+export const DEFAULT_AREAS: Record<string, string[]> = {
+  auth: ["**/auth/**", "**/auth*.*", "**/authn/**", "**/authz/**", "**/oauth/**", "**/oidc/**", "**/sso/**", "**/session/**", "**/sessions/**", "**/*token*", "**/*credential*", "**/*password*", "**/*secret*", "**/permission*/**", "**/rbac/**"],
+  billing: ["**/billing/**", "**/payment/**", "**/payments/**", "**/stripe/**", "**/invoice*/**"],
+  data: ["**/migration/**", "**/migrations/**", "*.sql", "**/schema/**", "**/schema.*", "**/prisma/**"],
+  infra: ["**/terraform/**", "*.tf", "**/k8s/**", "**/helm/**", "Dockerfile*", "**/infra/**", ".github/workflows/**"],
+  prompts: ["**/prompts/**", "**/prompt/**", "*.prompt.*", "**/system-prompt*"],
+};
+
+export const DEFAULT_KINDS: Record<ChangeKind, Tier> = {
+  docs: "low",
+  test: "low",
+  additive: "low",
+  deps: "medium",
+  config: "medium",
+  ci: "high",
+  logic: "medium",
+};
+
+export const DEFAULT_HUMANS: Record<Tier, 0 | 1 | 2> = { low: 0, medium: 1, high: 2 };
+
+export const DEFAULT_RULES: PolicyRule[] = [
+  { area: "auth", tier: "high", reason: "touches auth" },
+  { area: "billing", tier: "high", reason: "touches billing" },
+  { area: "data", tier: "high", reason: "touches data schema or migrations" },
+  { area: "infra", tier: "high", reason: "touches infra or CI" },
+  { area: "prompts", tier: "medium", reason: "touches prompts" },
+];
+
+export const DEFAULT_POLICY: Policy = { areas: DEFAULT_AREAS, kinds: DEFAULT_KINDS, humans: DEFAULT_HUMANS, rules: DEFAULT_RULES, source: "built-in defaults" };
+
+const KINDS: ChangeKind[] = ["docs", "test", "deps", "ci", "config", "additive", "logic"];
+const TIERS: Tier[] = ["low", "medium", "high"];
+const isTable = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+const isStringArray = (v: unknown): v is string[] => Array.isArray(v) && v.every((x) => typeof x === "string");
+
+/**
+ * Validate the `areas` and `policy` tables of a parsed TOML document, layered over `base`.
+ * `areas` replaces areas by name (an empty list removes one); `policy.rules` replaces the rule list.
+ */
+export function validatePolicy(raw: Record<string, unknown>, source: string, base: Policy = DEFAULT_POLICY): Result<Policy> {
+  const policy: Policy = { ...base, areas: { ...base.areas }, kinds: { ...base.kinds }, humans: { ...base.humans }, rules: [...base.rules], source };
+
+  if (raw.areas !== undefined) {
+    if (!isTable(raw.areas)) return err(`${source}: [areas] must be a table of name = [globs]`);
+    for (const [name, globs] of Object.entries(raw.areas)) {
+      if (!isStringArray(globs)) return err(`${source}: areas.${name} must be an array of glob strings`);
+      if (globs.length === 0) delete policy.areas[name];
+      else policy.areas[name] = globs;
+    }
+  }
+
+  if (raw.policy !== undefined) {
+    if (!isTable(raw.policy)) return err(`${source}: [policy] must be a table`);
+    for (const key of Object.keys(raw.policy)) {
+      if (!["kinds", "humans", "rules"].includes(key)) return err(`${source}: unknown key "policy.${key}" (expected kinds, humans, rules)`);
+    }
+    const p = raw.policy;
+    if (p.kinds !== undefined) {
+      if (!isTable(p.kinds)) return err(`${source}: [policy.kinds] must be a table`);
+      for (const [kind, tier] of Object.entries(p.kinds)) {
+        if (!KINDS.includes(kind as ChangeKind)) return err(`${source}: policy.kinds.${kind}: unknown kind (expected ${KINDS.join(", ")})`);
+        if (!TIERS.includes(tier as Tier)) return err(`${source}: policy.kinds.${kind} must be one of ${TIERS.join(", ")}`);
+        policy.kinds[kind as ChangeKind] = tier as Tier;
+      }
+    }
+    if (p.humans !== undefined) {
+      if (!isTable(p.humans)) return err(`${source}: [policy.humans] must be a table`);
+      for (const [tier, n] of Object.entries(p.humans)) {
+        if (!TIERS.includes(tier as Tier)) return err(`${source}: policy.humans.${tier}: unknown tier`);
+        if (n !== 0 && n !== 1 && n !== 2) return err(`${source}: policy.humans.${tier} must be 0, 1 or 2`);
+        policy.humans[tier as Tier] = n;
+      }
+    }
+    if (p.rules !== undefined) {
+      if (!Array.isArray(p.rules)) return err(`${source}: policy.rules must be an array of [[policy.rules]] tables`);
+      const rules: PolicyRule[] = [];
+      for (const [k, r] of p.rules.entries()) {
+        const where = `${source}: policy.rules[${k}]`;
+        if (!isTable(r)) return err(`${where} must be a table`);
+        for (const key of Object.keys(r)) if (!["area", "kind", "attention", "tier", "reason"].includes(key)) return err(`${where}: unknown key "${key}"`);
+        if (!TIERS.includes(r.tier as Tier)) return err(`${where}: tier must be one of ${TIERS.join(", ")}`);
+        const rule: PolicyRule = { tier: r.tier as Tier };
+        if (r.area !== undefined) {
+          if (typeof r.area !== "string" || !(r.area in policy.areas)) return err(`${where}: area "${String(r.area)}" is not defined in [areas] (known: ${Object.keys(policy.areas).join(", ")})`);
+          rule.area = r.area;
+        }
+        if (r.kind !== undefined) {
+          if (!KINDS.includes(r.kind as ChangeKind)) return err(`${where}: unknown kind "${String(r.kind)}"`);
+          rule.kind = r.kind as ChangeKind;
+        }
+        if (r.attention !== undefined) {
+          if (r.attention !== "needs-eyes" && r.attention !== "suspicious") return err(`${where}: attention must be needs-eyes or suspicious`);
+          rule.attention = r.attention;
+        }
+        if (r.reason !== undefined) {
+          if (typeof r.reason !== "string") return err(`${where}: reason must be a string`);
+          rule.reason = r.reason;
+        }
+        if (!rule.area && !rule.kind && !rule.attention) return err(`${where}: needs at least one of area, kind, attention`);
+        rules.push(rule);
+      }
+      policy.rules = rules;
+    }
+  }
+  return ok(policy);
+}

@@ -0,0 +1,7 @@
+import pkg from "../../package.json" with { type: "json" };
+
+const args = process.argv.slice(2);
+if (args.includes("--version") || args.includes("-v")) {
+  console.log(`lookout ${pkg.version}`);
+  process.exit(0);
+}
diff --git a/test/version.test.ts b/test/version.test.ts
new file mode 100644
index 0000000..a50027e
--- /dev/null
+++ b/test/version.test.ts
@@ -0,0 +1,7 @@
+import { expect, test } from "bun:test";
+
+test("lookout --version prints the package version", async () => {
+  const proc = Bun.spawn(["bun", "bin/lookout", "--version"], { stdout: "pipe" });
+  const out = await new Response(proc.stdout).text();
+  expect(out.trim()).toBe("lookout 0.1.0");
+});
